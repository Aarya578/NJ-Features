  {
   "default": "<div style=\"max-width: 1200px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;\">\n    {% if doc.kms_content_child %}\n        {% for row in doc.kms_content_child %}\n        <!-- Content Table -->\n        <table style=\"width: 100%; margin-bottom: 30px; border-collapse: collapse; background: white; border: 2px solid #007bff;\">\n            <tbody>\n                <tr>\n                    <!-- Title &amp;amp;amp;amp;amp;amp;amp;amp;amp;amp; Critical Points Column -->\n                    <td style=\"width: 33.33%; padding: 20px; border: 2px solid #007bff; vertical-align: top; background: #f8f9fa;\">\n                        <div style=\"font-weight: bold; color: #000; margin-bottom: 10px; font-size: 18px; text-align: center;\">TITLE</div>\n                        <div style=\"color: #000; line-height: 1.5; font-size: 14px; text-align: left;\">\n                            {% if row.title and row.title.strip() %}\n                                {{ row.title.strip() }}\n                            {% else %}\n                                <span style=\"color: #6c757d; font-style: italic;\">No title provided</span>\n                            {% endif %}\n                        </div>\n                        <div style=\"font-weight: bold; color: #000; margin: 20px 0 10px 0; font-size: 18px; text-align: center;\">CRITICAL POINTS</div>\n                        <div style=\"color: #000; line-height: 1.5; font-size: 14px; text-align: left;\">\n                            {% if row.critical_points %}\n                                {{ row.critical_points }}\n                            {% else %}\n                                <span style=\"color: #6c757d; font-style: italic;\">No critical points provided</span>\n                            {% endif %}\n                        </div>\n                    </td>\n\n                    <!-- Image/Video Column -->\n                    <td style=\"width: 66.67%; padding: 20px; border: 2px solid #007bff; vertical-align: top; background: #e3f2fd; text-align: center;\">\n                        <div style=\"font-weight: bold; color: #000; margin-bottom: 10px; font-size: 18px; text-align: center;\">IMAGE/VIDEO</div>\n\n                        <!-- Image Section -->\n                        <div style=\"margin-bottom: 15px; display: flex; justify-content: center;\">\n                            {% if row.image %}\n                                {% if row.image.startswith(\"http\") %}\n                                    <img alt=\"Knowledge Base Image\" src=\"{{ row.image }}\" style=\"width: 100%; max-width: 600px; height: auto; border-radius: 6px;\">\n                                {% else %}\n                                    <div style=\"background: #fff3cd; padding: 10px; border-radius: 4px; border: 1px solid #ffc107; font-size: 14px;\">\n                                        <strong>\ud83d\udcf7 Image Text:</strong> {{ row.image }}\n                                    </div>\n                                {% endif %}\n                            {% else %}\n                                <div style=\"color: #6c757d; font-style: italic; padding: 10px; background: #f8f9fa; border-radius: 4px;\">\n                                    \ud83d\udcf7 No image provided\n                                </div>\n                            {% endif %}\n                        </div>\n\n                        <!-- Video Section -->\n                        <div>\n                            {% if row.video %}\n                                {% if \"youtube.com\" in row.video or \"youtu.be\" in row.video %}\n                                    <!-- Embed YouTube Video -->\n                                    &lt;iframe width=\"100%\" height=\"315\" src=\"{{ row.video | replace('watch?v=', 'embed/') | replace('youtu.be/', 'youtube.com/embed/') }}\" \n                                        title=\"Knowledge Base Video\" frameborder=\"0\" allowfullscreen style=\"border-radius: 8px;\"&gt;&lt;/iframe&gt;\n                                {% else %}\n                                    <!-- Fallback for direct video files like .mp4 -->\n                                    <video controls height=\"315\" style=\"border-radius: 8px;\" width=\"100%\">\n                                        <source src=\"{{ row.video }}\" type=\"video/mp4\">\n                                        Your browser does not support the video tag.\n                                    </video>\n                                {% endif %}\n                            {% else %}\n                                <div style=\"background: #f8f9fa; color: #6c757d; font-style: italic; padding: 10px; border-radius: 4px;\">\n                                    \ud83c\udfa5 No video provided\n                                </div>\n                            {% endif %}\n                        </div>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n        {% endfor %}\n    {% else %}\n        <div style=\"text-align: center; padding: 40px; background: #f8f9fa; border-radius: 8px; color: #6c757d; border: 2px dashed #dee2e6;\">\n            <h4 style=\"margin: 0 0 10px 0;\">No content available</h4>\n            <p style=\"margin: 0;\">No child content found in the knowledge base.</p>\n        </div>\n    {% endif %}\n</div>\n",
   "fieldname": "html_content",
   "fieldtype": "HTML Editor",
   "ignore_xss_filter": 1,
   "label": "Html Content"
