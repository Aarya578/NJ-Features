 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n    .print-format div,\n    .print-format p {\n        font: arial;\n        margin: 0;\n        vertical-align: middle;\n    }\n    \n    @media screen {\n        .print-format {\n            width: 50mm;\n            padding: 0;\n            max-height: 12mm;\n        }\n    }\n</style>\n\n{% if doc.name %}\n<div id=\"textContainerParent\" style=\"display: flex; justify-content: space-between; align-items: center; width: auto; padding: 1mm;\">\n    <div id=\"text-container\" style=\"overflow: hidden; text-overflow: ellipsis; max-height: 10mm; width: 80%\" data-id=1>\n        <p id=\"text\">{{ doc.name }}</p>\n    </div>\n    <img id=\"qrCodeImage\" style=\"width: auto; max-height: 10mm;\" src=\"{{ frappe.utils.get_url() }}/files/{{ qr_code_name }}.png\" alt=\"{{ qr_code_name }}\">\n</div>\n{% endif %}\n\n<script>\n    // Function to check if element overflows its parent\n    const isOverflown = ({ clientHeight, scrollHeight }) => scrollHeight > clientHeight;\n\n    // Resizing function for the text element\n    const resizeText = ({ element, minSize = 5, maxSize = 26, step = 1, unit = 'px' }) => {\n        let i = minSize;\n        let overflow = false;\n        const parent = element.parentNode;\n        \n        while (!overflow && i < maxSize) {\n            element.style.fontSize = `${i}${unit}`;\n            overflow = isOverflown(parent);\n            \n            if (!overflow) i += step;\n        }\n        \n        // Revert to last state where no overflow happened\n        element.style.fontSize = `${i - step}${unit}`;\n    };\n\n    // Call the resizeText function on the text element\n    const textElement = document.getElementById('text');\n    resizeText({ element: textElement, step: 0.5 });\n    \n    // Ensure that qr_code_name is not null before using it\n    const searchParams = new URLSearchParams(window.location.search);\n    const qr_code_name = searchParams.get('qr_code_name');\n    if (qr_code_name) {\n        document.getElementById('qrCodeImage').src = \"{{ frappe.utils.get_url() }}/files/\" + qr_code_name +\".png\";\n        document.getElementById('qrCodeImage').alt = qr_code_name;\n    }\n</script>",
 "idx": 0,
