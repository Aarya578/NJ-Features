 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div class=\\\"print-heading\\\">\\t\\t\\t\\t<h2><div>Delivery Note</div><br><small class=\\\"sub-heading\\\">{{ doc.name }}</small>\\t\\t\\t\\t</h2></div>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"company\", \"print_hide\": 0, \"label\": \"Company\"}]",
 "html": "\n<html>\n<body>\n   \n    {% set doc_dict = doc.as_dict() %}\n    \n       <div id=\"flex-container\">\n          <img src=\"data:image/png;base64,\n          \n          kA0srBR7ZTyb3cuwv78dfCayd67Vgg7UUDChLXAWbcrcFWpWEPSPB62fdi7nbxm0+Z8X6McCJVbDEGZKR/cnoejS0QEGbW1JsLVtC6DOakSch/HXAfrJzvRqsWCOgXZgKti8iuJuxoc1Sa8/cuNlcSaK50cfMLidWwZLbYMfrc/TJILApC/QlUT7cAaHyfaTURUjbugsUF4F1cb\n          0erLz+cA4GqGB30uQfEK8UIVmb072YO/Gpe+TOS7tKpxOrYEm2Y9eWltwK9jRmliPnS+PFWdLa2eARFDWX+4J1cr0ebDAT7M7BABXsxhjUwmJwuBdncoGQVtpTvXjjcmIFLIncuHe2teR+UgvbtbG02I1wcVA9mWQkBF9Ro6Kd/F3BurneADaQ9ozEqQZ2Jq//u8Ae5EJiZw\n          dKv6p5sdOJFbA0BgSmY1o6wAbpVtlBkcSJvDeTPCN2vcK1vz/YCq63gJWDAYsbwSI6sOHrb2URy04caF7sdmIILLAsKDRygQ2C1UjZ9IJwJvY8UbCuF+DpUOOOYH+r4HoL2OAgBQPa21otVvXio6WNKu0XdGLQil2P5myxZ3VnOJb3s+GWukPgsS22kuu3zu8VW8DKwYCnba0+V\n          \n          \n          PVcX6OqwV7A9ZEP4AXrh8/vQH1mYD++r9LHhz6AF6z0ywdQX+go98+fDH3S5H3Yy8vLy8vLy8vLy8vLy8vLy8vLy8vLy8vLy8vLy+vt6n/O0XtuB57zDAAAAABJRU5ErkJggg==\" width=\"150\" height=\"200px\"> </img>   \n        <div id=\"box1\">\n            <p><strong>Brand :</strong> &nbsp {{ doc_dict.get('brand') }}</p>\n            <p><strong>Model :</strong> &nbsp{{ doc_dict.get('model') }}</p>\n            <p><strong>Processor :</strong>&nbsp {{ doc_dict.get('processor_type') }}</p>\n            <p><strong>RAM :</strong>&nbsp {{ doc_dict.get('ram_capacity') }}</p>\n            <p><strong>HDD :</strong>&nbsp {{ doc_dict.get('storage_capacity') }}</p>\n            <p><strong>OS :</strong>&nbsp {{ doc_dict.get('os') }}</p>\n            <p><strong>Quantity :</strong>&nbsp  {{ doc_dict.get('qty') }}</p>\n            <p><strong>BIOS Serial No :</strong>&nbsp {{ doc_dict.get('bios_serial_no') }}</p>\n        </div>\n\n        <div id=\"box2\">\n            {% if doc_dict.get('barcode') %}\n                {% for serial_number in doc_dict.get('barcode').split('\\n') %}\n                    {% if serial_number != \"\" %}\n                        <div id=\"serial-container\">\n                            <p><strong>S/No :</strong></p>\n                            <p id=\"serial-text\">&nbsp {{ serial_number }}</p>\n                            <img id=\"serial-img\" src=\"{{ frappe.utils.get_url() }}/files/{{ serial_number }}.png\" alt=\"{{ serial_number }}\">\n                        </div>\n                    {% endif %}\n                {% endfor %}\n            {% endif %}\n\n            {% if doc_dict.get('truncated_item_code') %}\n                <h2>Item Code:</h2>\n                <p>{{ doc_dict.get('truncated_item_code') }}</p>\n                <img src=\"{{ frappe.utils.get_url() }}/files/{{ doc_dict.get('decoded_item_code') }}\" alt=\"{{ doc_dict.get('decoded_item_code') }}\"><br>\n            {% endif %}\n        </div>\n\n        <div id=\"box3\">\n            <p><strong>Customer Care :</strong> &nbsp {{ doc_dict.get('customer_care') }}</p>\n            <p><strong>Refurb By :</strong> \n                {{ doc_dict.get('refurb_by')[:28] }}\n                {{ doc_dict.get('refurb_by')[28:59] }}\n                {{ doc_dict.get('refurb_by')[59:] }}\n            </p>\n        </div>\n\n        <div id=\"box4\">\n            <!--<p><strong>Date Of Refurb :</strong> &nbsp {{ doc_dict.get('date_of_refurb') }}</p>-->\n            <p><strong>Country Of Refurb :</strong> &nbsp {{ doc_dict.get('country_of_refurb') }}</p>\n            <p><strong>MRP :</strong> &nbsp {{ doc_dict.get('mrp') }}</p>\n        </div>\n    </div>\n</body>\n</html>\n",
