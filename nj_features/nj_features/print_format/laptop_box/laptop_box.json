 "css": "/* Flex container for the boxes, column-wise layout */\n#flex-container {\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-start;\n    align-items: stretch;\n    width: 100%;\n    max-width: 1000px;\n    padding: 10px;\n    transform: rotate(90deg);\n    transform-origin: center;\n    margin-right: 0px;\n    margin-top: 200px;\n}\n\n/* Style for boxes */\n#flex-container > div {\n    border-radius: 5px;\n    padding: 10px;\n    margin: 0; /* Remove margin between boxes */\n    width: 60%; /* Full width for column layout */\n    background: #fff;\n    position: relative;\n}\n\n/* Add border line at the end of each box */\n#flex-container > div::after {\n    content: '';\n    display: block;\n    border-bottom: 2px solid black;\n    position: absolute; /* Absolute positioning for border */\n    width: 100%;\n    bottom: 0; /* Position the border at the bottom */\n    left: 0;\n}\n\n/* Text size adjustments */\np {\n    font-size: 8px;\n}\n\n/* Style for the serial number and QR code container */\n#serial-container {\n    display: flex;\n    align-items: center;\n    margin-bottom: 0; /* Remove bottom margin */\n}\n\n#serial-text {\n    margin-right: 0; /* Remove space between text and QR code */\n    font-size: 14px;\n}\n\n#serial-img {\n    height: 50px;\n    width: auto;\n}\n\n/* Style for images */\nimg {\n    max-width: 100%;\n    height: auto;\n}\n\n/* Responsive design for print */\n@media print {\n    #serial-container {\n        display: flex;\n        justify-content: space-between;\n        width: 100%;\n    }\n    #serial-text {\n        font-size: 10px;\n        margin-right: 0; /* Remove space between text and QR code */\n    }\n    #serial-img {\n        height: 30px;\n    }\n}",
