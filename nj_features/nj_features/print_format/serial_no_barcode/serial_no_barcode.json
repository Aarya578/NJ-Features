 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Responsive Text in Div</title>\n    <style>\n        #resizable-div {\n            width: 49.8mm; /* Set width to match printer requirements */\n            height: 10mm; /* Set height to match printer requirements */\n            position: relative;\n            display: flex;\n            align-items: center;\n            justify-content: flex-start; /* Adjust alignment as needed */\n        }\n        \n        #text-span {\n            word-wrap: break-word;\n            white-space: normal; /* Allow text to wrap */\n            max-width: calc(49.8mm - 60px); /* Adjust max-width for text wrapping */\n            word-break: break-all; /* Ensure long words break to next line */\n        }\n\n        .qr-code {\n            height: 50px;\n            width: 50px; /* Fixed size for QR code */\n            margin-left: 5px; /* Adjust margin or padding as needed */\n        }\n\n        body {\n            display: flex;\n            margin: auto;\n            justify-content: space-evenly;\n            align-items: center; /* Align items vertically in the center */\n        }\n\n        img {\n            width: auto;\n            height: 50px;\n            display: inline;\n        }\n\n        @media print {\n            body {\n                margin: 0; /* Remove default margin */\n            }\n\n            #resizable-div {\n                width: 49.8mm; /* Ensure consistent width for printing */\n                height: 10mm; /* Ensure consistent height for printing */\n                padding: 0; /* Remove padding for print */\n            }\n\n            #text-span {\n                max-width: calc(49.8mm - 60px); /* Adjust max-width for print */\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"resizable-div\">\n        <span id=\"text-span\">{{ doc.serial_no }}</span><img src=\"{{ frappe.utils.get_url() }}/files/{{ doc.serial_no }}.png\" class=\"qr-code\">\n    </div>\n</body>\n</html>\n",
