 "html": "<style>\n    .print-format div,\n    .print-format span {\n        font-family: Arial;\n        margin: 0;\n        vertical-align: middle;\n        line-height: 1; /* Ensure minimal line height */\n    }\n    \n    @media screen {\n        .print-format {\n            width: 53mm;\n            height: 12mm; /* Adjust height to match content */\n            padding: 1mm; /* Add padding for spacing */\n            display: flex;\n            justify-content: center; /* Center horizontally */\n            align-items: flex-start; /* Align items at the top */\n            box-sizing: border-box; /* Ensure padding is included in width calculation */\n        }\n        .print-format #textContainerParent {\n            width: 53mm; /* Full width of the container */\n            display: flex;\n            justify-content: center; /* Center the content horizontally */\n            align-items: flex-start; /* Align items at the top */\n        }\n        .print-format #text-container {\n            width: 48mm; /* Width of content */\n            display: flex;\n            justify-content: center; /* Center items horizontally */\n            align-items: center; /* Center items vertically */\n        }\n        .print-format #text-container span {\n            margin: 0; /* Ensure no margin inside the text container */\n            overflow: hidden;\n            text-overflow: ellipsis;\n            max-width: 80%; /* Adjust max-width to fit within 48mm with padding */\n            text-align: center; /* Center text horizontally */\n            word-wrap: break-word; /* Wrap text to next line if it exceeds container width */\n        }\n        .print-format #qrCodeImage {\n            max-width: 20%; /* Adjust max-width to fit within 48mm with padding */\n            max-height: 10mm; /* Adjust max-height to fit within 10mm */\n        }\n    }\n</style>\n\n{% if doc.serial_no %}\n<div class=\"print-format\">\n    <div id=\"textContainerParent\">\n        <div id=\"text-container\">\n            <span id=\"text\">{{ doc.serial_no }}</span>\n            <img id=\"qrCodeImage\" src=\"{{ frappe.utils.get_url() }}/files/{{ doc.serial_no }}.png\">\n        </div>\n    </div>\n</div>\n{% endif %}\n",
