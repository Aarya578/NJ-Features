 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Responsive Text in Div</title>\n    <style>\n        #resizable-div {\n            width: 200px;\n            position: relative; /* Position relative to allow absolute positioning inside */\n        }\n        \n        #text-span {\n            display: block;\n            word-wrap: break-word;\n            white-space: normal; /* Allow text to wrap */\n        }\n\n        .qr-code {\n            height: 50px;\n            width: 50px; /* Fixed size for QR code */\n            position: absolute;\n            top: 0;\n            right: 0; /* Position QR code to the top right */\n        }\n\n        @media print {\n            /*.print-format {*/\n            /*    width: 20mm;*/\n            /*    max-height: 20mm;*/\n            /*    padding: 2mm;*/\n            /*    margin: 0;*/\n            /*}*/\n        }\n\n        body {\n            display: flex;\n            margin: auto;\n            justify-content: space-evenly;\n            vertical-align: middle;\n        }\n\n        h5 {\n            display: inline;\n        }\n\n        img {\n            width: auto;\n            height: 50px;\n            display: inline;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"resizable-div\">\n        <span id=\"text-span\">{{ doc.serial_no }}</span>\n        <img src=\"{{ frappe.utils.get_url() }}/files/{{ doc.serial_no }}.png\" class=\"qr-code\">\n    </div>\n\n    <script>\n        window.onload = function() {\n            let textSpan = document.getElementById('text-span');\n            let resizableDiv = document.getElementById('resizable-div');\n        };\n\n        window.onresize = function() {\n            let textSpan = document.getElementById('text-span');\n            let resizableDiv = document.getElementById('resizable-div');\n        };\n    </script>\n</body>\n</html>\n",
