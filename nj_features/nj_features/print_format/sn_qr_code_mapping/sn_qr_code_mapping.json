 "html": "\n<style>\n    #resizable-div {\n        width: 54mm; \n        height: 15mm; \n        position: relative;\n        display: flex;\n        align-items: center; /* Center items vertically */\n        justify-content: center; /* Align items to the start horizontally */\n        box-sizing: border-box; /* Include padding and border in element's total width and height */\n        padding-top: 3mm;\n    }\n    \n    #text-span {\n        word-wrap: break-word;\n        white-space: normal; /* Allow text to wrap */\n        max-width: calc(49.8mm - 60px); /* Adjust max-width for text wrapping */\n        word-break: break-all; /* Ensure long words break to next line */\n        line-height: 1; /* Adjust line height to ensure text fits within the div */\n        margin: 0px 5px 0px 10px; /* Remove default margin */\n    }\n\n    .qr-code {\n        max-height: 10mm;\n        width: auto;\n        margin auto;\n    }\n</style>\n<div id=\"resizable-div\">\n    <span id=\"text-span\">{{ doc.serial_no }}</span>\n    <img src=\"{{ frappe.utils.get_url() }}/files/{{ doc.serial_no }}.png\" class=\"qr-code\" onerror=\"this.onerror=null; this.src='{{ frappe.utils.get_url() }}/files/{{ doc.serial_no }}_qr.jpg';\">\n</div>",
